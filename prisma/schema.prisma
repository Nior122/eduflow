generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  FINANCE_OFFICER
  TEACHER
  PARENT
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  SICK
}

enum FeeStatus {
  PAID
  PENDING
  PARTIAL
  OVERDUE
  WAIVED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MOBILE_MONEY
  CHEQUE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Term {
  FIRST
  SECOND
  THIRD
}

enum ClassCategory {
  PRIMARY
  JUNIOR_SECONDARY
  SENIOR_SECONDARY
}

enum StudentAdmissionStatus {
  ACTIVE
  SUSPENDED
  GRADUATED
  TRANSFERRED
  WITHDRAWN
  ARCHIVED
}

// ─── PHASE 4: EXAMINATIONS & ACADEMIC RECORDS ────────────────────────

enum ExaminationType {
  CA
  MID_TERM
  FINAL
  MOCK
  PROMOTION
}

enum ExaminationStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AssessmentKind {
  CA
  EXAM
}

enum ResultStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
  LOCKED
}

enum PromotionStatus {
  PENDING
  PROMOTED
  REPEATED
}

enum PromotionAction {
  PROMOTED
  REPEATED
  GRADUATED
  TRANSFERRED
  ARCHIVED
}

// ─── USER & AUTH ─────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String?
  name          String?
  role          UserRole   @default(SCHOOL_ADMIN)
  emailVerified DateTime?
  image         String?
  phone         String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  schoolId        String?
  school          School?        @relation(fields: [schoolId], references: [id])
  student         Student?
  teacher         Teacher?
  parent          Parent?
  accounts        Account[]
  sessions        Session[]
  notifications   Notification[]
  authoredAnnouncements Announcement[]
  sentMessages     Message[]     @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")
  staffAttendanceMarked StaffAttendance[]
  createdExaminations    Examination[]
  enteredScores          AssessmentScore[]
  generatedReportCards   ReportCard[]
  generatedTranscripts   Transcript[]
  resultApprovals        ResultApprovalRecord[]
  approvedResults        Result[] @relation("ResultApprovedBy")
  publishedResults       Result[] @relation("ResultPublishedBy")
  lockedResults          Result[] @relation("ResultLockedBy")
  promotionsBy           PromotionRecord[]
  graduationsBy          GraduationRecord[]
  issuedInvoices         Invoice[]          @relation("InvoiceIssuedBy")
  cancelledInvoices      Invoice[]          @relation("InvoiceCancelledBy")
  paymentsReceived       Payment[]
  receiptsIssued         Receipt[]
  discountsCreated       Discount[]         @relation("DiscountCreatedBy")
  discountsApproved      Discount[]         @relation("DiscountApprovedBy")
  plansCreated           PaymentPlan[]
  auditLogs              FinanceAuditLog[]
  preference             UserPreference?
  activityLogs           UserActivityLog[]
  uploadedDocuments      SchoolDocument[]    @relation("DocumentUploader")
  aiConversations        AiConversation[]
  aiUsageLogs            AiUsageLog[]
  knowledgeUploads       KnowledgeBaseDocument[] @relation("KBUploader")
  promptEdits            PromptTemplate[]       @relation("PromptEditor")
  questionBank           QuestionBank[]         @relation("QuestionAuthor")
  examsGenerated         GeneratedExam[]        @relation("ExamAuthor")
  libraryAuditLogs       LibraryAuditLog[]

  supportTicketsCreated  SupportTicket[] @relation("TicketCreatedBy")
  supportTicketsAssigned SupportTicket[] @relation("TicketAssignedTo")
  couponsCreated         Coupon[]        @relation("CouponCreatedBy")
  auditEntries           AuditLog[]      @relation("AuditActor")
  backupJobsCreated      BackupJob[]     @relation("BackupCreatedBy")

  @@index([email])
  @@index([role])
  @@index([schoolId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── SCHOOL ─────────────────────────────────────────────────────────

model School {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   String?
  phone     String?
  email     String?
  website   String?
  logo      String?
  motto     String?
  principal String?
  currency  String   @default("NGN")
  timeZone  String?
  primaryColor   String?
  secondaryColor String?
  gradeSystem    String?   @db.Text
  attendanceRules String?  @db.Text
  category  ClassCategory @default(PRIMARY)
  status            String           @default("ACTIVE") // ACTIVE | SUSPENDED — super admin control
  onboardingStep    Int              @default(0)
  onboardingComplete Boolean         @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  students      Student[]
  teachers      Teacher[]
  parents       Parent[]
  classes       Class[]
  subjects      Subject[]
  fees          Fee[]
  payments      Payment[]
  announcements Announcement[]
  documents      SchoolDocument[]
  aiSetting           AiSetting?
  promptTemplates     PromptTemplate[]
  aiConversations     AiConversation[]
  aiUsageLogs         AiUsageLog[]
  knowledgeDocuments  KnowledgeBaseDocument[]
  questionBank        QuestionBank[]
  examsGenerated      GeneratedExam[]
  lessonPlans   LessonPlan[]
  departments  Department[]
  sessions     AcademicSession[]
  terms        AcademicTerm[]
  classrooms   Classroom[]
  timetableEntries TimetableEntry[]
  calendarEvents   CalendarEvent[]
  assignments      Assignment[]
  homework         Homework[]
  staffAttendances StaffAttendance[]
  teacherAssignments TeacherAssignment[]
  examinations      Examination[]
  assessmentTypes   AssessmentType[]
  gradeBands        GradeBand[]
  feeCategories     FeeCategory[]
  discounts         Discount[]
  paymentGatewayConfigs PaymentGatewayConfig[]
  numberSequences   NumberSequence[]
  libraryCategories   LibraryCategory[]
  libraryAuthors      LibraryAuthor[]
  libraryPublishers   LibraryPublisher[]
  libraryBooks        LibraryBook[]
  libraryCopies       LibraryCopy[]
  libraryBorrows      LibraryBorrow[]
  libraryReservations LibraryReservation[]
  libraryReadingHistory LibraryReadingHistory[]
  libraryFines        LibraryFine[]
  librarySettings     LibrarySettings?
  libraryAuditLogs    LibraryAuditLog[]

  subscription       Subscription?
  onboarding         SchoolOnboarding?
  featureFlags       FeatureFlag[]
  usageRecords       UsageRecord[]
  auditLogs          AuditLog[]
  billingInvoices    BillingInvoice[]
  apiKeys            ApiKey[]
  webhookEndpoints   WebhookEndpoint[]
  webhookEventLogs   WebhookEventLog[]
  supportTickets     SupportTicket[]

  @@index([slug])
}

// ─── STUDENT ────────────────────────────────────────────────────────

model Student {
  id              String     @id @default(cuid())
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  gender          Gender?
  address         String?
  phone           String?
  email           String?
  admissionNumber String     @unique
  enrollmentDate  DateTime   @default(now())
  medicalInfo     String?
  middleName      String?
  bloodGroup      String?
  religion        String?
  nationality     String?
  state           String?
  lga             String?
  emergencyContactName  String?
  emergencyContactPhone String?
  previousSchool        String?
  disabilities          String?
  profileImage    String?
  isActive        Boolean    @default(true)
  admissionStatus StudentAdmissionStatus @default(ACTIVE)
  suspendedAt     DateTime?
  graduatedAt     DateTime?
  transferredAt   DateTime?
  promotedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  schoolId      String
  school        School              @relation(fields: [schoolId], references: [id])
  classId       String?
  class         Class?              @relation(fields: [classId], references: [id])
  parentId      String?
  parentRelation String?
  parent        Parent?             @relation(fields: [parentId], references: [id])
  userId        String?             @unique
  user          User?               @relation(fields: [userId], references: [id])
  attendances   Attendance[]
  results       Result[]
  feeRecords    FeeRecord[]
  aiReports     AIReportComment[]
  performanceAnalyses PerformanceAnalysis[]
  timeline StudentTimeline[]
  homeworkSubmissions HomeworkSubmission[]
  assignmentSubmissions AssignmentSubmission[]
  scores        AssessmentScore[]
  reportCards   ReportCard[]
  transcript    Transcript?
  promotionRecords PromotionRecord[]
  graduationRecords GraduationRecord[]
  invoices      Invoice[]
  receipts      Receipt[]
  discounts     Discount[]
  paymentPlans  PaymentPlan[]
  latePayments  LatePayment[]
  libraryBorrows      LibraryBorrow[]
  libraryReservations LibraryReservation[]
  libraryReadingHistory LibraryReadingHistory[]
  libraryFines        LibraryFine[]

  @@index([admissionNumber])
  @@index([schoolId])
  @@index([classId])
  @@index([parentId])
  @@index([admissionStatus])
}

// ─── TEACHER ────────────────────────────────────────────────────────

model Teacher {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  email          String   @unique
  phone          String?
  employeeDate   DateTime @default(now())
  qualification  String?
  specialization String?
  staffId           String?   @unique
  yearsOfExperience Int?
  salaryGrade       String?
  address           String?
  departmentId      String?
  department        Department? @relation("TeacherMembership", fields: [departmentId], references: [id])
  profileImage   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id])
  userId        String?        @unique
  user          User?          @relation(fields: [userId], references: [id])
  classSubjects ClassSubject[]
  attendances   Attendance[]
  results       Result[]
  lessonPlans   LessonPlan[]
  comments      AIReportComment[]
  performances  PerformanceAnalysis[]
  headedDepartments     Department[] @relation("DepartmentHead")
  classroomsTaught      Classroom[] @relation("ClassroomClassTeacher")
  classroomsAssistant   Classroom[] @relation("ClassroomAssistantTeacher")
  timetableEntries      TimetableEntry[]
  homework              Homework[]
  assignments           Assignment[]
  staffAttendances      StaffAttendance[]
  teacherAssignments    TeacherAssignment[]
  classTeacherReportCards ReportCard[]

  @@index([email])
  @@index([schoolId])
  @@index([departmentId])
}

// ─── PARENT ─────────────────────────────────────────────────────────

model Parent {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String?
  address   String?
  occupation String?
  profileImage String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId String
  school   School    @relation(fields: [schoolId], references: [id])
  userId   String?   @unique
  user     User?     @relation(fields: [userId], references: [id])
  children Student[]

  @@index([email])
  @@index([schoolId])
}

// ─── CLASS ──────────────────────────────────────────────────────────

model Class {
  id        String        @id @default(cuid())
  name      String
  category  ClassCategory @default(PRIMARY)
  section   String?
  capacity  Int?
  isActive  Boolean  @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id])
  students      Student[]
  classSubjects ClassSubject[]
  attendances   Attendance[]
  results       Result[]
  classrooms    Classroom[]
  timetableEntries TimetableEntry[]
  calendarEvents   CalendarEvent[]
  assignments      Assignment[]
  homework         Homework[]
  teacherAssignments TeacherAssignment[]
  examinationClasses ExaminationClass[]
  scores            AssessmentScore[]
  reportCards       ReportCard[]
  fromPromotions    PromotionRecord[] @relation("PromotionFromClass")
  toPromotions      PromotionRecord[] @relation("PromotionToClass")
  announcements     Announcement[]
  questions         QuestionBank[]
  generatedExams    GeneratedExam[]
  fees              Fee[]
  discounts         Discount[]

  @@unique([name, schoolId])
  @@index([schoolId])
}

// ─── SUBJECT ────────────────────────────────────────────────────────

model Subject {
  id        String   @id @default(cuid())
  name      String
  code      String?
  category  ClassCategory?
  description String?
  passMark    Int?
  creditUnit  Int?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id])
  classSubjects ClassSubject[]
  attendances   Attendance[]
  results       Result[]
  timetableEntries TimetableEntry[]
  assignments      Assignment[]
  homework         Homework[]
  teacherAssignments TeacherAssignment[]
  scores            AssessmentScore[]

  @@unique([name, schoolId])
  @@index([schoolId])
  questions         QuestionBank[]
  generatedExams    GeneratedExam[]

}

// ─── CLASS-SUBJECT (Many-to-Many with Teacher) ──────────────────────

model ClassSubject {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
}

// ─── ATTENDANCE ─────────────────────────────────────────────────────

model Attendance {
  id        String           @id @default(cuid())
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  remark    String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  @@unique([studentId, date, subjectId])
  @@index([classId, date])
  @@index([studentId])
  @@index([date])
}

// ─── RESULT / EXAMINATION ───────────────────────────────────────────
// Extended for Phase 4: weighted CA aggregation, workflow status,
// position engine, and full audit trail. Legacy fields (term, session,
// assignment, test, exam) are preserved for Phase 3 compatibility.

model Result {
  id         String   @id @default(cuid())
  term       Term     @default(FIRST)
  session    String   @default("2025/2026")
  assignment Decimal? @db.Decimal(5, 2)
  test       Decimal? @db.Decimal(5, 2)
  exam       Decimal? @db.Decimal(5, 2)
  total      Decimal? @db.Decimal(5, 2)
  percentage Decimal? @db.Decimal(5, 2)
  caScore    Decimal? @db.Decimal(5, 2)
  examScore  Decimal? @db.Decimal(5, 2)
  grade      String?
  remark     String?
  status     ResultStatus @default(DRAFT)
  subjectPosition Int?
  classPosition   Int?
  totalStudents   Int?
  approvedById String?
  approvedBy   User?   @relation("ResultApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  publishedById String?
  publishedBy  User?   @relation("ResultPublishedBy", fields: [publishedById], references: [id])
  publishedAt  DateTime?
  lockedById   String?
  lockedBy     User?   @relation("ResultLockedBy", fields: [lockedById], references: [id])
  lockedAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  academicSessionId String?
  academicSession   AcademicSession? @relation(fields: [academicSessionId], references: [id])
  academicTermId    String?
  academicTerm      AcademicTerm?    @relation(fields: [academicTermId], references: [id])
  approvals ResultApprovalRecord[]

  @@unique([studentId, subjectId, term, session])
  @@index([studentId])
  @@index([classId])
  @@index([subjectId])
  @@index([classId, subjectId, academicSessionId, academicTermId, status])
}

model ResultApprovalRecord {
  id         String   @id @default(cuid())
  action     String   // SUBMIT | APPROVE | PUBLISH | LOCK | REJECT
  fromStatus ResultStatus?
  toStatus   ResultStatus
  note       String?  @db.Text
  createdAt  DateTime @default(now())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])
  resultId String
  result   Result @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@index([actorId])
}

// ─── FEE MANAGEMENT ─────────────────────────────────────────────────

model Fee {
  id          String     @id @default(cuid())
  name        String
  description String?
  amount      Decimal    @db.Decimal(10, 2)
  dueDate     DateTime?
  isOptional  Boolean    @default(false)
  term        Term?
  session     String?
  isActive    Boolean    @default(true)
  isRecurring Boolean    @default(false)
  lateFee     Decimal?   @db.Decimal(10, 2)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id])
  feeRecords    FeeRecord[]
  invoiceItems  InvoiceItem[]
  feeCategoryId String?
  feeCategory   FeeCategory? @relation(fields: [feeCategoryId], references: [id])
  classId       String?
  class         Class?       @relation(fields: [classId], references: [id])
  departmentId  String?
  department    Department?  @relation(fields: [departmentId], references: [id])
  discounts     Discount[]

  @@index([schoolId])
  @@index([feeCategoryId])
  @@index([classId])
}

model FeeRecord {
  id        String    @id @default(cuid())
  amount    Decimal   @db.Decimal(10, 2)
  status    FeeStatus @default(PENDING)
  dueDate   DateTime?
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  feeId     String
  fee       Fee      @relation(fields: [feeId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  @@unique([feeId, studentId])
  @@index([studentId])
  @@index([feeId])
}

model Payment {
  id            String        @id @default(cuid())
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod @default(CASH)
  reference     String        @unique
  transactionId String?
  status        FeeStatus     @default(PAID)
  paidAt        DateTime      @default(now())
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  schoolId      String
  school        School        @relation(fields: [schoolId], references: [id])
  feeRecords    FeeRecord[]
  invoicePayments InvoicePayment[]
  receipt       Receipt?
  receivedById  String?
  receivedBy    User?         @relation(fields: [receivedById], references: [id])
  gateway       String?
  gatewayReference String?
  gatewayStatus String?

  @@index([schoolId])
  @@index([reference])
  @@index([receivedById])
}

// ─── ANNOUNCEMENTS & COMMUNICATION ─────────────────────────────────

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  priority  String   @default("NORMAL")
  audience  String   @default("ALL")
  published Boolean  @default(true)
  isActive  Boolean  @default(true)
  pinned    Boolean  @default(false)
  expiresAt DateTime?
  attachmentUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  authorId String?
  author   User?  @relation(fields: [authorId], references: [id])
  targetClassId      String?
  targetClass        Class?      @relation(fields: [targetClassId], references: [id])
  targetDepartmentId String?
  targetDepartment   Department? @relation(fields: [targetDepartmentId], references: [id])

  @@index([schoolId])
  @@index([createdAt])
  @@index([pinned])
  @@index([targetClassId])
  @@index([targetDepartmentId])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String   @db.Text
  type      String   @default("INFO")
  read      Boolean  @default(false)
  link      String?
  readAt    DateTime?
  schoolId  String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@index([schoolId])
}

model Message {
  id        String   @id @default(cuid())
  subject   String
  content   String   @db.Text
  read      Boolean  @default(false)
  readAt    DateTime?
  isDraft   Boolean  @default(false)
  deletedBySender   Boolean @default(false)
  deletedByReceiver Boolean @default(false)
  conversationId String?
  replyToId String?
  replyTo   Message?  @relation("MessageReply", fields: [replyToId], references: [id])
  replies   Message[] @relation("MessageReply")
  attachments Json?
  createdAt DateTime @default(now())

  senderId   String
  sender     User   @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User   @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([conversationId])
  @@index([receiverId, deletedByReceiver, read])
}

// ─── PHASE 6: DOCUMENTS, PREFERENCES & ACTIVITY ─────────────────────

enum DocumentCategory {
  HANDBOOK
  POLICY
  TIMETABLE
  STUDY_MATERIAL
  FORM
  CIRCULAR
  PAST_QUESTION
  OTHER
}

model SchoolDocument {
  id          String           @id @default(cuid())
  title       String
  description String?
  category    DocumentCategory @default(OTHER)
  fileName    String
  fileUrl     String
  fileSize    Int              @default(0)
  mimeType    String?
  audience    String           @default("ALL") // ALL | TEACHERS | PARENTS | STUDENTS | STAFF
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  schoolId   String
  school     School @relation(fields: [schoolId], references: [id])
  uploaderId String?
  uploader   User?  @relation("DocumentUploader", fields: [uploaderId], references: [id])

  @@index([schoolId])
  @@index([category])
  @@index([audience])
}

model UserPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  language            String   @default("en")
  theme               String   @default("SYSTEM") // SYSTEM | LIGHT | DARK
  emailNotifications  Boolean  @default(true)
  smsNotifications    Boolean  @default(true)
  pushNotifications   Boolean  @default(true)
  inAppNotifications  Boolean  @default(true)
  twoFactorEnabled    Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserActivityLog {
  id         String   @id @default(cuid())
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId String?

  @@index([userId, createdAt])
  @@index([schoolId, createdAt])
  @@index([entityType, entityId])
}

// ─── PHASE 7: EDUFLOW AI ───────────────────────────────────────────

enum KbSourceType {
  TEXT
  PDF
  WORD
  EXCEL
  OTHER
}

enum QuestionType {
  MCQ
  THEORY
  TRUE_FALSE
  FILL_BLANK
  MATCHING
  PRACTICAL
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

model AiSetting {
  id                 String   @id @default(cuid())
  provider           String   @default("openai") // openai | anthropic | gemini | groq | openrouter | github | cloudflare
  model              String?
  temperature        Float    @default(0.7)
  maxTokens          Int      @default(2048)
  streamingEnabled   Boolean  @default(true)
  modulesEnabled     Json?    // { lesson_planner: true, ... }
  rolePermissions    Json?    // per-module role gating
  monthlyBudgetCents Int      @default(20000)
  fallbackProvider   Boolean  @default(true)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  schoolId String @unique
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model PromptTemplate {
  id          String   @id @default(cuid())
  key         String
  name        String
  description String?
  content     String   @db.Text
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId    String
  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  updatedById String?
  updatedBy   User?   @relation("PromptEditor", fields: [updatedById], references: [id])

  @@unique([schoolId, key, version])
  @@index([schoolId, key, isActive])
}

model AiConversation {
  id        String   @id @default(cuid())
  module    String   @default("assistant")
  title     String   @default("New chat")
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([schoolId])
}

model AiUsageLog {
  id               String   @id @default(cuid())
  module           String
  provider         String
  model            String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costUsd          Float    @default(0)
  latencyMs        Int      @default(0)
  status           String   @default("OK")
  error            String?
  createdAt        DateTime @default(now())

  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
  @@index([module, createdAt])
}

model KnowledgeBaseDocument {
  id           String       @id @default(cuid())
  title        String
  description  String?
  sourceType   KbSourceType @default(TEXT)
  fileName     String?
  fileUrl      String?
  content      String?      @db.Text
  chunks       Json?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  schoolId     String
  school       School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?   @relation("KBUploader", fields: [uploadedById], references: [id])

  @@index([schoolId, isActive])
}

model QuestionBank {
  id          String             @id @default(cuid())
  topic       String
  difficulty  QuestionDifficulty @default(MEDIUM)
  type        QuestionType       @default(MCQ)
  question    String             @db.Text
  options     Json?
  answer      String             @db.Text
  explanation String?            @db.Text
  marks       Int                @default(1)
  aiGenerated Boolean            @default(true)
  createdAt   DateTime           @default(now())

  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id])
  createdById String?
  createdBy   User?    @relation("QuestionAuthor", fields: [createdById], references: [id])

  @@index([schoolId, subjectId])
  @@index([schoolId, classId])
  @@index([difficulty])
}

model GeneratedExam {
  id            String   @id @default(cuid())
  title         String
  instructions  String?  @db.Text
  durationMins  Int?
  sections      Json
  markingScheme Json?
  answerKey     Json?
  difficultyCoverage Json?
  createdAt     DateTime @default(now())

  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id])
  createdById String?
  createdBy   User?    @relation("ExamAuthor", fields: [createdById], references: [id])

  @@index([schoolId, createdAt])
}

// ─── AI GENERATED CONTENT ──────────────────────────────────────────

model LessonPlan {
  id              String   @id @default(cuid())
  subject         String
  class           String
  topic           String
  duration        String
  objectives      String   @db.Text
  materials       String   @db.Text
  introduction    String   @db.Text
  activities      String   @db.Text
  teacherActivity String   @db.Text
  studentActivity String   @db.Text
  assessment      String   @db.Text
  homework        String   @db.Text
  extensionActivities String? @db.Text
  aiGenerated     Boolean  @default(true)
