  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  @@index([studentId])
}

model PerformanceAnalysis {
  id              String   @id @default(cuid())
  strengths       String   @db.Text
  weaknesses      String   @db.Text
  riskLevel       String   @default("LOW")
  recommendations String   @db.Text
  overallScore    Decimal? @db.Decimal(5, 2)
  createdAt       DateTime @default(now())

  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  @@index([studentId])
}


// ─── PHASE 2: ACADEMIC STRUCTURE ─────────────────────────────────────

model Department {
  id          String   @id @default(cuid())
  name        String
  code        String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id])
  headTeacherId String?
  headTeacher   Teacher?  @relation("DepartmentHead", fields: [headTeacherId], references: [id])
  teachers      Teacher[] @relation("TeacherMembership")
  subjects      Subject[]
  fees          Fee[]
  announcements Announcement[]

  @@unique([name, schoolId])
  @@index([schoolId])
}

model AcademicSession {
  id         String   @id @default(cuid())
  name       String
  startDate  DateTime?
  endDate    DateTime?
  isActive   Boolean  @default(false)
  isLocked   Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  schoolId String
  school   School         @relation(fields: [schoolId], references: [id])
  terms    AcademicTerm[]
  timetableEntries TimetableEntry[]
  teacherAssignments TeacherAssignment[]
  examinations Examination[]
  scores      AssessmentScore[]
  results     Result[]
  reportCards ReportCard[]
  invoices    Invoice[]
  promotionRecords PromotionRecord[]
  graduationRecords GraduationRecord[]

  @@unique([name, schoolId])
  @@index([schoolId])
}

model AcademicTerm {
  id        String   @id @default(cuid())
  name      Term
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  schoolId  String?
  school    School?         @relation(fields: [schoolId], references: [id])
  timetableEntries TimetableEntry[]
  teacherAssignments TeacherAssignment[]
  examinations Examination[]
  configs     TermAssessmentConfig[]
  scores      AssessmentScore[]
  results     Result[]
  reportCards ReportCard[]
  invoices    Invoice[]

  @@unique([sessionId, name])
  @@index([sessionId])
}

model Classroom {
  id                 String   @id @default(cuid())
  name               String
  roomNumber         String?
  location           String?
  capacity           Int?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id])
  classId            String?
  class              Class?   @relation(fields: [classId], references: [id])
  classTeacherId     String?
  classTeacher       Teacher? @relation("ClassroomClassTeacher", fields: [classTeacherId], references: [id])
  assistantTeacherId String?
  assistantTeacher   Teacher? @relation("ClassroomAssistantTeacher", fields: [assistantTeacherId], references: [id])
  timetableEntries   TimetableEntry[]

  @@index([schoolId])
  @@index([classId])
  @@index([classTeacherId])
}

model StudentTimeline {
  id        String   @id @default(cuid())
  event     String
  note      String?
  createdAt DateTime @default(now())

  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([createdAt])
}


// ─── PHASE 3: ACADEMIC OPERATIONS ─────────────────────────────────────

model TimetableEntry {
  id        String   @id @default(cuid())
  day       String
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId    String
  school      School          @relation(fields: [schoolId], references: [id])
  classId     String
  class       Class           @relation(fields: [classId], references: [id])
  subjectId   String
  subject     Subject         @relation(fields: [subjectId], references: [id])
  teacherId   String?
  teacher     Teacher?        @relation(fields: [teacherId], references: [id])
  classroomId String?
  classroom   Classroom?      @relation(fields: [classroomId], references: [id])
  sessionId   String?
  session     AcademicSession? @relation(fields: [sessionId], references: [id])
  termId      String?
  term        AcademicTerm?    @relation(fields: [termId], references: [id])

  @@index([schoolId, day])
  @@index([classId, day])
  @@index([teacherId, day])
  @@index([classroomId, day])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  eventDate   DateTime
  startTime   String?
  endTime     String?
  type        String   @default("EVENT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId String
  school   School  @relation(fields: [schoolId], references: [id])
  classId  String?
  class    Class?  @relation(fields: [classId], references: [id])

  @@index([schoolId, eventDate])
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  dueDate     DateTime
  maxScore    Int?
  attachments String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id])
  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  submissions AssignmentSubmission[]

  @@index([schoolId])
  @@index([classId])
  @@index([teacherId])
}

model AssignmentSubmission {
  id          String   @id @default(cuid())
  content     String?  @db.Text
  attachments String?  @db.Text
  submittedAt DateTime @default(now())
  grade       Int?
  feedback    String?  @db.Text
  gradedAt    DateTime?

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model Homework {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  dueDate     DateTime
  attachments String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id])
  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  submissions HomeworkSubmission[]

  @@index([schoolId])
  @@index([classId])
}

model HomeworkSubmission {
  id          String   @id @default(cuid())
  content     String?  @db.Text
  attachments String?  @db.Text
  submittedAt DateTime @default(now())
  grade       Int?
  feedback    String?  @db.Text
  gradedAt    DateTime?

  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@index([studentId])
}

model StaffAttendance {
  id         String           @id @default(cuid())
  date       DateTime
  status     AttendanceStatus @default(PRESENT)
  remark     String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  teacherId  String
  teacher    Teacher  @relation(fields: [teacherId], references: [id])
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id])
  markedById String?
  markedBy   User?    @relation(fields: [markedById], references: [id])

  @@unique([teacherId, date])
  @@index([schoolId, date])
}

model TeacherAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherId String
  teacher   Teacher          @relation(fields: [teacherId], references: [id])
  classId   String
  class     Class            @relation(fields: [classId], references: [id])
  subjectId String
  subject   Subject          @relation(fields: [subjectId], references: [id])
  sessionId String?
  session   AcademicSession? @relation(fields: [sessionId], references: [id])
  termId    String?
  term      AcademicTerm?    @relation(fields: [termId], references: [id])
  schoolId  String
  school    School           @relation(fields: [schoolId], references: [id])

  @@unique([teacherId, classId, subjectId, sessionId, termId])
  @@index([teacherId])
  @@index([classId, subjectId])
}

// ─── PHASE 4: EXAMINATIONS & ACADEMIC RECORDS ────────────────────────

// An assessment event (e.g. "First CA", "Final Examination") for a
// session + term. Classes participate via ExaminationClass.

model Examination {
  id          String            @id @default(cuid())
  name        String
  type        ExaminationType   @default(CA)
  description String?
  status      ExaminationStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  schoolId   String
  school     School         @relation(fields: [schoolId], references: [id])
  sessionId  String
  session    AcademicSession @relation(fields: [sessionId], references: [id])
  termId     String
  term       AcademicTerm    @relation(fields: [termId], references: [id])
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id])
  classes    ExaminationClass[]
  scores     AssessmentScore[]

  @@unique([schoolId, name, sessionId, termId])
  @@index([schoolId])
  @@index([sessionId, termId])
  @@index([status])
}

model ExaminationClass {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())

  examinationId String
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  classId       String
  class         Class       @relation(fields: [classId], references: [id])

  @@unique([examinationId, classId])
  @@index([classId])
}

// Configurable assessment components (school-defined weights).
// Example: Assignment 10% · Class Test 20% · Project 10% · Exam 60%.

model AssessmentType {
  id        String        @id @default(cuid())
  name      String
  code      String?
  kind      AssessmentKind @default(CA)
  weight    Int           @default(0)
  maxScore  Int           @default(100)
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  schoolId String
  school   School   @relation(fields: [schoolId], references: [id])
  configs  TermAssessmentConfig[]
  scores   AssessmentScore[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// Per-term override of an assessment component's weight / max score.

model TermAssessmentConfig {
  id              String   @id @default(cuid())
  weight          Int
  maxScore        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  termId           String
  term             AcademicTerm   @relation(fields: [termId], references: [id], onDelete: Cascade)
  assessmentTypeId String
  assessmentType   AssessmentType @relation(fields: [assessmentTypeId], references: [id], onDelete: Cascade)

  @@unique([termId, assessmentTypeId])
  @@index([assessmentTypeId])
}

// School-configurable grading scale (percentage bands).

model GradeBand {
  id        String   @id @default(cuid())
  name      String
  minScore  Int
  maxScore  Int
  remark    String
  gpa       Decimal? @db.Decimal(3, 1)
  isPass    Boolean  @default(true)
  color     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name])
  @@index([schoolId])
}

// Raw assessment score entry. One row per student × subject × term ×
// assessment type — the unique constraint prevents duplicate entries.

model AssessmentScore {
  id         String   @id @default(cuid())
  score      Decimal  @db.Decimal(5, 2)
  maxScore   Int      @default(100)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  studentId       String
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId         String
  class           Class           @relation(fields: [classId], references: [id])
  subjectId       String
  subject         Subject         @relation(fields: [subjectId], references: [id])
  sessionId       String
  session         AcademicSession @relation(fields: [sessionId], references: [id])
  termId          String
  term            AcademicTerm    @relation(fields: [termId], references: [id])
  assessmentTypeId String
  assessmentType  AssessmentType  @relation(fields: [assessmentTypeId], references: [id])
  examinationId   String?
  examination     Examination?    @relation(fields: [examinationId], references: [id])
  enteredById     String?
  enteredBy       User?           @relation(fields: [enteredById], references: [id])

  @@unique([studentId, subjectId, sessionId, termId, assessmentTypeId])
  @@index([classId, subjectId, sessionId, termId])
  @@index([studentId])
  @@index([assessmentTypeId])
  @@index([examinationId])
}

// Student-level term report: averages, position, promotion status,
// comments, signatures and QR verification (architecture ready).

model ReportCard {
  id                String          @id @default(cuid())
  overallAverage    Decimal         @db.Decimal(5, 2)
  overallGrade      String?
  classPosition     Int?
  totalStudents     Int?
  promotionStatus   PromotionStatus @default(PENDING)
  classTeacherComment String?       @db.Text
  principalComment  String?         @db.Text
  verificationCode  String          @unique @default(cuid())
  qrCodeUrl         String?
  isPublished       Boolean         @default(false)
  publishedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  studentId   String
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId     String
  class       Class         @relation(fields: [classId], references: [id])
  sessionId   String
  session     AcademicSession @relation(fields: [sessionId], references: [id])
  termId      String
  term        AcademicTerm    @relation(fields: [termId], references: [id])
  classTeacherId String?
  classTeacher   Teacher?      @relation(fields: [classTeacherId], references: [id])
  generatedById  String?
  generatedBy    User?         @relation(fields: [generatedById], references: [id])

  @@unique([studentId, sessionId, termId])
  @@index([classId, sessionId, termId])
  @@index([studentId])
}

model Transcript {
  id               String   @id @default(cuid())
  lastGeneratedAt  DateTime @default(now())

  studentId String @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  generatedById String?
  generatedBy   User?  @relation(fields: [generatedById], references: [id])

  @@index([studentId])
}

model PromotionRecord {
  id        String          @id @default(cuid())
  action    PromotionAction @default(PROMOTED)
  note      String?         @db.Text
  createdAt DateTime        @default(now())

  studentId   String
  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromClassId String
  fromClass   Class           @relation("PromotionFromClass", fields: [fromClassId], references: [id])
  toClassId   String?
  toClass     Class?          @relation("PromotionToClass", fields: [toClassId], references: [id])
  sessionId   String
  session     AcademicSession @relation(fields: [sessionId], references: [id])
  byUserId    String
  byUser      User            @relation(fields: [byUserId], references: [id])

  @@index([studentId])
  @@index([sessionId])
  @@index([fromClassId])
}

model GraduationRecord {
  id                String   @id @default(cuid())
  certificateNumber String?  @unique
  note              String?
  graduatedAt       DateTime @default(now())

  studentId String
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id])
  byUserId  String
  byUser    User            @relation(fields: [byUserId], references: [id])

  @@unique([studentId, sessionId])
  @@index([studentId])
}


// ─── PHASE 5: FINANCE, FEES & ACCOUNTING ─────────────────────────────

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  CANCELLED
  OVERDUE
}

enum DiscountType {
  PERCENTAGE
  FIXED
  WAIVER
  SCHOLARSHIP
  SIBLING
  STAFF
}

enum DiscountStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  EXPIRED
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  PAST_DUE
  CANCELLED
}

enum ReminderStatus {
  PENDING
  SENT
  RESOLVED
}

model FeeCategory {
  id          String   @id @default(cuid())
  name        String
  code        String?
  description String?
  color       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  fees     Fee[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  status         InvoiceStatus @default(DRAFT)
  amount         Decimal       @db.Decimal(10, 2) @default(0)
  discountAmount Decimal       @db.Decimal(10, 2) @default(0)
  paidAmount     Decimal       @db.Decimal(10, 2) @default(0)
  dueDate        DateTime?
  notes          String?       @db.Text
  issuedAt       DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     AcademicSession? @relation(fields: [sessionId], references: [id])
  termId      String?
  term        AcademicTerm?    @relation(fields: [termId], references: [id])
  discountId  String?
  discount    Discount?        @relation(fields: [discountId], references: [id])
  issuedById  String?
  issuedBy    User?            @relation("InvoiceIssuedBy", fields: [issuedById], references: [id])
  cancelledById String?
  cancelledBy User?            @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id])
  items       InvoiceItem[]
  payments    InvoicePayment[]
  receipts    Receipt[]
  latePayments LatePayment[]
  plan        PaymentPlan?

  @@index([studentId])
  @@index([status])
  @@index([sessionId, termId])
  @@index([invoiceNumber])
}

model InvoiceItem {
  id             String   @id @default(cuid())
  description    String
  amount         Decimal  @db.Decimal(10, 2)
  discountAmount Decimal  @db.Decimal(10, 2) @default(0)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeId     String?
  fee       Fee?    @relation(fields: [feeId], references: [id])

  @@index([invoiceId])
}

model InvoicePayment {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, paymentId])
  @@index([paymentId])
}

model Receipt {
  id            String        @id @default(cuid())
  receiptNumber String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        FeeStatus     @default(PAID)
  issuedAt      DateTime      @default(now())
  qrCode        String        @unique @default(cuid())
  notes         String?

  paymentId   String  @unique
  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student @relation(fields: [studentId], references: [id])
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  receivedById String?
  receivedBy   User?    @relation(fields: [receivedById], references: [id])

  @@index([studentId])
  @@index([issuedAt])
  @@index([receiptNumber])
}

model Discount {
  id         String         @id @default(cuid())
  name       String
  code       String?
  type       DiscountType
  value      Decimal        @db.Decimal(10, 2)
  scope      String         @default("STUDENT")
  reason     String?        @db.Text
  validFrom  DateTime?
  validUntil DateTime?
  appliedAt  DateTime?
  approvedAt DateTime?
  status     DiscountStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])
  classId   String?
  class     Class?   @relation(fields: [classId], references: [id])
  feeId     String?
  fee       Fee?     @relation(fields: [feeId], references: [id])
  createdById String?
  createdBy   User?    @relation("DiscountCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?    @relation("DiscountApprovedBy", fields: [approvedById], references: [id])
  invoices  Invoice[]

  @@index([studentId])
  @@index([status])
  @@index([type])
}

model PaymentPlan {
  id                String     @id @default(cuid())
  totalAmount       Decimal    @db.Decimal(10, 2)
  installmentAmount Decimal    @db.Decimal(10, 2)
  installmentCount  Int
  frequency         String     @default("MONTHLY")
  status            PlanStatus @default(ACTIVE)
  startDate         DateTime?
  dueDate           DateTime?
  endDate           DateTime?
  notes             String?    @db.Text
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoiceId   String?   @unique
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id])
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])

  @@index([studentId])
  @@index([status])
}

model LatePayment {
  id            String         @id @default(cuid())
  daysLate      Int            @default(0)
  penaltyAmount Decimal?       @db.Decimal(10, 2)
  status        ReminderStatus @default(PENDING)
  remindedAt    DateTime?
  note          String?
  createdAt     DateTime       @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([status])
}

model FinanceAuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ip        String?
  createdAt DateTime @default(now())

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([actorId])
}

model NumberSequence {
  id        String   @id @default(cuid())
  kind      String
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, kind, year])
}

model PaymentGatewayConfig {
  id            String   @id @default(cuid())
  gateway       String
  isActive      Boolean  @default(false)
  publicKey     String?
  secretKey     String?
  webhookSecret String?
  testMode      Boolean  @default(true)
  settings      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, gateway])
}

// ─── PHASE 8: LIBRARY MANAGEMENT ────────────────────────────────────

enum LibraryItemType {
  BOOK
  E_BOOK
  MAGAZINE
  PAST_QUESTION
  DIGITAL_RESOURCE
}

enum LibraryCopyCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
  LOST
}

enum LibraryCopyStatus {
  AVAILABLE
  BORROWED
  RESERVED
  MAINTENANCE
  LOST
}

enum LibraryBorrowStatus {
  BORROWED
  RETURNED
  OVERDUE
  LOST
}

enum LibraryReservationStatus {
  PENDING
  READY
  CANCELLED
  FULFILLED
  EXPIRED
}

enum LibraryFineStatus {
  PENDING
  PAID
  WAIVED
}

model LibraryCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  books LibraryBook[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

model LibraryAuthor {
  id          String   @id @default(cuid())
  name        String
  bio         String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  books LibraryBook[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

model LibraryPublisher {
  id          String   @id @default(cuid())
  name        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  books LibraryBook[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

model LibraryBook {
  id              String          @id @default(cuid())
  title           String
  subtitle        String?
  isbn            String?
  type            LibraryItemType @default(BOOK)
  language        String?
  description     String?         @db.Text
  coverUrl        String?
  fileUrl         String?
  pages           Int?
  shelfLocation   String?
  barcode         String?
  qrData          String?
  publicationYear Int?
  totalCopies     Int             @default(1)
  availableCopies Int             @default(1)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  schoolId    String
  school      School           @relation(fields: [schoolId], references: [id])
  categoryId  String?
  category    LibraryCategory? @relation(fields: [categoryId], references: [id])
  authorId    String?
  author      LibraryAuthor?   @relation(fields: [authorId], references: [id])
  publisherId String?
  publisher   LibraryPublisher? @relation(fields: [publisherId], references: [id])

  copies         LibraryCopy[]
  borrows        LibraryBorrow[]
  reservations   LibraryReservation[]
  readingHistory LibraryReadingHistory[]

  @@index([schoolId])
  @@index([schoolId, isActive])
  @@index([schoolId, type])
  @@index([categoryId])
  @@index([authorId])
  @@index([publisherId])
  @@index([isbn])
}

model LibraryCopy {
  id         String               @id @default(cuid())
  copyNumber Int
  barcode    String?
  condition  LibraryCopyCondition @default(GOOD)
  status     LibraryCopyStatus    @default(AVAILABLE)
  acquiredAt DateTime?
  isActive   Boolean              @default(true)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  schoolId String
  school   School      @relation(fields: [schoolId], references: [id])
  bookId   String
  book     LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  borrows LibraryBorrow[]

  @@unique([bookId, copyNumber])
  @@index([schoolId, status])
  @@index([schoolId, isActive])
  @@index([bookId])
  @@index([barcode])
}

model LibraryBorrow {
  id                 String               @id @default(cuid())
  borrowedAt         DateTime             @default(now())
  dueDate            DateTime
  returnedAt         DateTime?
  status             LibraryBorrowStatus  @default(BORROWED)
  note               String?
  returnedCondition  LibraryCopyCondition?
  lateFeeAmount      Decimal?             @db.Decimal(10, 2)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id])
  copyId    String
  copy      LibraryCopy  @relation(fields: [copyId], references: [id], onDelete: Cascade)
  bookId    String
  book      LibraryBook  @relation(fields: [bookId], references: [id])
  studentId String
  student   Student      @relation(fields: [studentId], references: [id])

  fine LibraryFine?

  @@index([schoolId, status])
  @@index([studentId, status])
  @@index([copyId, status])
  @@index([bookId])
  @@index([dueDate])
}

model LibraryReservation {
  id         String                    @id @default(cuid())
  reservedAt DateTime                  @default(now())
  expiresAt  DateTime
  status     LibraryReservationStatus  @default(PENDING)
  notified   Boolean                   @default(false)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id])
  bookId    String
  book      LibraryBook  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  studentId String
  student   Student      @relation(fields: [studentId], references: [id])

  @@index([schoolId, status])
  @@index([bookId, status])
  @@index([studentId, status])
  @@index([expiresAt])
}

model LibraryReadingHistory {
  id         String   @id @default(cuid())
  openedAt   DateTime @default(now())
  finishedAt DateTime?
  progress   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id])
  bookId    String
  book      LibraryBook  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  studentId String
  student   Student      @relation(fields: [studentId], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@index([bookId])
}

model LibraryFine {
  id        String            @id @default(cuid())
  amount    Decimal           @db.Decimal(10, 2)
  reason    String?
  status    LibraryFineStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  schoolId  String
  school    School        @relation(fields: [schoolId], references: [id])
  borrowId  String        @unique
  borrow    LibraryBorrow @relation(fields: [borrowId], references: [id], onDelete: Cascade)
  studentId String
  student   Student       @relation(fields: [studentId], references: [id])

  @@index([schoolId, status])
  @@index([studentId, status])
  @@index([status])
}

model LibrarySettings {
  id               String   @id @default(cuid())
  lateFeePerDay    Decimal  @db.Decimal(10, 2) @default(50)
  maxBorrowDays    Int      @default(14)
  maxActiveBorrows Int      @default(5)
  borrowEnabled    Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id])
}

model LibraryAuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ip        String?
  createdAt DateTime @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  actorId  String?
  actor    User?   @relation(fields: [actorId], references: [id])

  @@index([schoolId, entity, entityId])
  @@index([schoolId, action])
  @@index([createdAt])
  @@index([actorId])
}

// ═══════════════════════════════════════════════════════════════════
// PHASE 9 — MULTI-TENANT SAAS LAYER
// ═══════════════════════════════════════════════════════════════════

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}
enum SubscriptionCycle {
  MONTHLY
  YEARLY
}
enum BillingProvider {
  STRIPE
  PAYSTACK
  FLUTTERWAVE
}
enum BillingInvoiceStatus {
  DRAFT
  OPEN
  PAID
  OVERDUE
  VOID
  FAILED
}
enum CouponDiscountType {
  PERCENT
  FIXED
}
enum SupportTicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}
enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
enum UsageMetric {
  STUDENTS
  TEACHERS
  API_CALLS
  AI_TOKENS
  STORAGE_KB
  LOGINS
}
enum FeatureModule {
  LIBRARY
  TRANSPORT
  PAYROLL
  AI
  HOSTEL
  CLINIC
  INVENTORY
  CERTIFICATES
  MESSAGING
  REPORTS
  BILLING
}
enum BackupJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}
enum EmailLogStatus {
  QUEUED
  SENT
  FAILED
}
enum WebhookEventStatus {
  PENDING
  DELIVERED
  FAILED
}

/// Platform-level SaaS plan (Starter / Professional / Business / Enterprise).
model SubscriptionPlan {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  description  String?
  priceMonthly Int      @default(0) // minor units (cents/kobo)
  priceYearly  Int      @default(0)
  currency     String   @default("USD")
  features     Json // { maxStudents, maxTeachers, storageMb, aiTokensPerMonth, apiCallsPerMonth, modules: { FeatureModule: boolean } }
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]

  @@index([isActive])
}

/// A school's SaaS subscription (one per school).
model Subscription {
  id                     String             @id @default(cuid())
  status                 SubscriptionStatus @default(TRIALING)
  cycle                  SubscriptionCycle  @default(MONTHLY)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  provider               BillingProvider?
  providerSubscriptionId String?
  providerCustomerId     String?
  billingEmail           String?
  nextPaymentDate        DateTime?
  amountMinor            Int                @default(0)
  currency               String             @default("USD")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  schoolId String
  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId   String
  plan     SubscriptionPlan  @relation(fields: [planId], references: [id])

  invoices BillingInvoice[]

  @@unique([schoolId])
  @@index([status])
  @@index([planId])
  @@index([providerSubscriptionId])
}

/// Platform invoice for a school subscription (distinct from school fee Invoice).
model BillingInvoice {
  id                 String               @id @default(cuid())
  number             String               @unique
  status             BillingInvoiceStatus @default(OPEN)
  amountMinor        Int                  @default(0)
  discountMinor      Int                  @default(0)
  currency           String               @default("USD")
  provider           BillingProvider?
  providerInvoiceId  String?
  couponCode         String?
  periodStart        DateTime?
  periodEnd          DateTime?
  dueDate            DateTime?
  paidAt             DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([schoolId, createdAt])
  @@index([status])
  @@index([providerInvoiceId])
}

/// Discount codes applied at checkout (platform-wide, created by super admin).
model Coupon {
  id              String             @id @default(cuid())
  code            String             @unique
  description     String?
  discountType    CouponDiscountType @default(PERCENT)
  discountValue   Int                @default(0) // percent (1-100) or fixed minor units
  currency        String? // required when discountType = FIXED
  maxRedemptions  Int?
  redemptionCount Int                @default(0)
  validFrom       DateTime?
  validUntil      DateTime?
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  createdById     String?
  createdBy       User?              @relation("CouponCreatedBy", fields: [createdById], references: [id])

  @@index([isActive])
}

/// Per-school override of plan module access (defaults come from the plan).
model FeatureFlag {
  id        String        @id @default(cuid())
  module    FeatureModule
  enabled   Boolean       @default(true)
  updatedAt DateTime      @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, module])
}

/// Aggregated usage counters, one row per school/metric/month.
model UsageRecord {
  id        String      @id @default(cuid())
  metric    UsageMetric
  period    String // YYYY-MM (UTC)
  value     Int         @default(0)
  updatedAt DateTime    @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, metric, period])
  @@index([schoolId, metric])
}

/// Platform audit trail (auth/security/billing events across tenants).
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  category   String // AUTH | BILLING | TENANT | SECURITY | ADMIN | ONBOARDING | API
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])
  actorId  String?
  actor    User?   @relation("AuditActor", fields: [actorId], references: [id])

  @@index([schoolId, createdAt])
  @@index([actorId, createdAt])
  @@index([category, createdAt])
}

/// Super-admin support tickets (schools open, platform answers).
model SupportTicket {
  id          String                @id @default(cuid())
  subject     String
  description String                @db.Text
  status      SupportTicketStatus   @default(OPEN)
  priority    SupportTicketPriority @default(MEDIUM)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  schoolId     String?
  school       School? @relation(fields: [schoolId], references: [id])
  createdById  String?
  createdBy    User?   @relation("TicketCreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?   @relation("TicketAssignedTo", fields: [assignedToId], references: [id])

  @@index([status])
  @@index([schoolId, createdAt])
}

/// Singleton platform configuration (id = 1).
model PlatformSettings {
  id                Int      @id @default(1)
  allowRegistration Boolean  @default(true)
  defaultTrialDays  Int      @default(14)
  defaultPlanCode   String   @default("STARTER")
  maintenanceMode   Boolean  @default(false)
  maintenanceMessage String?
  currency          String   @default("USD")
  supportEmail      String?
  announcements     Json?
  updatedAt         DateTime @updatedAt
}

/// Onboarding progress for a school (steps stored as a Json map).
model SchoolOnboarding {
  id          String   @id @default(cuid())
  currentStep Int      @default(1)
  steps       Json // { "1": { done: true, data: {...} }, ... }
  isComplete  Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId])
}

/// API keys for the versioned REST API (/api/v1). Only the SHA-256 hash is stored.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String // first 8 chars, shown in the UI
  keyHash    String    @unique // sha256(key)
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

/// Outbound webhook endpoint (event notifications).
model WebhookEndpoint {
  id        String   @id @default(cuid())
  url       String
  secret    String? // HMAC signing secret for deliveries
  events    String[] // e.g. ["student.created", "payment.received"]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  deliveries WebhookEventLog[]

  @@index([schoolId])
}

/// Delivery attempt log for outbound webhooks (retried by the daily cron).
model WebhookEventLog {
  id             String             @id @default(cuid())
  event          String
  payload        Json
  status         WebhookEventStatus @default(PENDING)
  attempts       Int                @default(0)
  responseStatus Int?
  nextAttemptAt  DateTime?
  createdAt      DateTime           @default(now())
  deliveredAt    DateTime?

  schoolId   String?
  school     School?         @relation(fields: [schoolId], references: [id])
  endpointId String?
  endpoint   WebhookEndpoint? @relation(fields: [endpointId], references: [id])

  @@index([status, nextAttemptAt])
  @@index([schoolId, createdAt])
}

/// Database backup job record (actual dump runs in scripts/backup.ts).
model BackupJob {
  id          String           @id @default(cuid())
  kind        String           @default("MANUAL") // MANUAL | SCHEDULED
  status      BackupJobStatus  @default(PENDING)
  url         String?
  sizeBytes   Int?
  startedAt   DateTime?
  completedAt DateTime?
  error       String?
  createdAt   DateTime         @default(now())

  createdById String?
  createdBy   User? @relation("BackupCreatedBy", fields: [createdById], references: [id])

  @@index([status, createdAt])
}

/// Outbound transactional email log.
model EmailLog {
  id        String         @id @default(cuid())
  to        String
  subject   String
  template  String?
  status    EmailLogStatus @default(QUEUED)
  provider  String?
  error     String?
  createdAt DateTime       @default(now())

  @@index([status, createdAt])
  @@index([to, createdAt])
}
