# Database (PostgreSQL — Neon-compatible)
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/eduflow?sslmode=require"

# Auth — REQUIRED in production (generate with: openssl rand -base64 32)
AUTH_SECRET="your-auth-secret-change-in-production"
AUTH_URL="http://localhost:3000"

# AI (OpenAI-compatible) — optional; the app falls back to built-in answers
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# Optional transactional email (Resend) — needed for password reset links
# in production. Without it, the reset link is returned by the API in dev mode.
RESEND_API_KEY="re_xxx"
RESEND_FROM="EduFlow <noreply@eduflow.app>"

# ─── EduFlow AI (Phase 7) ─────────────────────────────────────────────
# Provider keys — set at least ONE. The school AI settings page selects
# which provider to use; keys are never exposed to clients.
OPENAI_API_KEY="sk-..."            # openai (default provider)
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY="sk-ant-..."     # anthropic
GEMINI_API_KEY="..."               # google gemini
GROQ_API_KEY="gsk_..."             # groq
OPENROUTER_API_KEY="sk-or-..."     # openrouter
GITHUB_TOKEN="ghp_..."             # github models
CLOUDFLARE_API_TOKEN="..."         # cloudflare ai (also needs CLOUDFLARE_ACCOUNT_ID)
CLOUDFLARE_ACCOUNT_ID="..."
