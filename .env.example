# ─────────────────────────────────────────────────────────────────────
# EduFlow — environment template
#   cp .env.example .env.local    then fill in the values below.
# ─────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────
# PostgreSQL connection string. Neon recommended: use the POOLED
# connection string here and let DIRECT_URL be auto-derived from the
# non-pooler host by scripts/migrate-deploy.mjs (or set it explicitly).
DATABASE_URL="postgresql://user:password@host:5432/eduflow?sslmode=require"
# DIRECT_URL="postgresql://user:password@host:5432/eduflow?sslmode=require"

# ── Auth (required in production) ────────────────────────────────────
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""
# AUTH_URL="http://localhost:3000"   # dev only

# ── AI providers (set at least ONE key to enable AI features) ────────
# OpenAI
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# Anthropic
# ANTHROPIC_API_KEY=""
# Google Gemini
# GEMINI_API_KEY=""
# Groq
# GROQ_API_KEY=""
# OpenRouter
# OPENROUTER_API_KEY=""
# GitHub Models (free tier — fine-grained PAT with Models access)
# GITHUB_TOKEN=""
# Cloudflare AI
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_ACCOUNT_ID=""

# ── Email (optional — password reset) ────────────────────────────────
# RESEND_API_KEY=""
# RESEND_FROM="EduFlow <no-reply@eduflow.app>"

# ── Object storage (optional) ────────────────────────────────────────
# STORAGE_PROVIDER="cloudinary"
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# ── Billing (optional) ───────────────────────────────────────────────
# STRIPE_SECRET_KEY=""
# PAYSTACK_SECRET_KEY=""
# FLUTTERWAVE_SECRET_KEY=""

# ── Cron / webhooks / alerts ─────────────────────────────────────────
# CRON_SECRET=""
# ALERT_WEBHOOK_URL=""

# ── Demo seed (optional override) ────────────────────────────────────
# Password used by the isolated demo tenant (prisma/seed-demo.ts).
# Defaults to "EduflowDemo#2026" when unset.
# DEMO_SEED_PASSWORD="EduflowDemo#2026"
